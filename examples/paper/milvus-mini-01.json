{
  "schema_version": 1,
  "experiment_name": "milvus-mini-01",
  "engine_profile": "milvus-native-dense",
  "artifact_dir": "./artifacts/milvus-mini-01",
  "execution": {
    "dataset": "milvus-mini-01",
    "dataset_description": "Set the dataset name and characteristics before experiments.",
    "host": "127.0.0.1",
    "connection_params": {
      "port": 19532
    },
    "distance": "l2",
    "vector_size": 128,
    "top_k": 10,
    "search_parallel": 16,
    "upload_parallel": 16,
    "batch_size": 1024,
    "hardware": {
      "cpu_cores_per_database": 16,
      "memory_gib_per_database": 64
    }
  },
  "runner": {
    "plugin": "vector-db-benchmark",
    "settings": {
      "repo_path": "../../external/vector-db-benchmark",
      "python_executable": "python",
      "dataset_path": "../../data/minidbs/mini-01.hdf5",
      "state_reuse": false,
      "keep_workspace": true,
      "timeout_s": 86400,
      "pass_env": [
        "PGVECTOR_PASSWORD"
      ]
    }
  },
  "lifecycle": {
    "mode": "docker_compose",
    "settings": {
      "compose_file": "./deploy/milvus.compose.yml",
      "project_name": "eigen-milvus-mini-01",
      "endpoint": "127.0.0.1",
      "environment": {
        "EIGEN_PORT": "19532",
        "EIGEN_HTTP_PORT": "9093"
      },
      "ready_check": {
        "kind": "tcp",
        "host": "127.0.0.1",
        "port": 19532,
        "timeout_s": 180
      },
      "command_timeout_s": 300,
      "remove_volumes": true,
      "server_config": {
        "kind": "milvus_yaml",
        "service": "milvus"
      }
    }
  },
  "tuning": {
    "strategy": "calm",
    "budget": 20,
    "initial_samples": null,
    "proposals_per_round": 12,
    "evaluations_per_round": 4,
    "regions_per_round": 1,
    "seed": 43,
    "recall_threshold": 0.9,
    "objectives": [
      {
        "metric": "qps",
        "direction": "maximize"
      }
    ]
  },
  "llm": {
    "model": "gpt-5.4",
    "temperature": null,
    "max_tokens": null,
    "extra_body": {
      "reasoning_effort": "medium"
    }
  }
}
