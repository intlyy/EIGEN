{
  "schema_version": 1,
  "id": "milvus-hnsw-dense",
  "display_name": "Milvus dense HNSW",
  "adapter": {
    "plugin": "vector-db-benchmark",
    "engine": "milvus",
    "api_version": "1",
    "options": {}
  },
  "capabilities": {
    "vector_kinds": ["dense"],
    "distances": ["l2", "cosine", "dot"],
    "filters": ["exact", "range", "geo"],
    "indexes": ["hnsw"],
    "notes": [
      "The vector-db-benchmark adapter normalizes cosine vectors and uses inner product.",
      "Geo-radius requires explicit client payload-ID prefilter compatibility; its cost is included in each Milvus search, not native Milvus 2.3 geo support."
    ]
  },
  "experiment": {
    "template": {
      "name": "eigen",
      "engine": "milvus",
      "connection_params": {},
      "collection_params": {},
      "upload_params": {
        "parallel": 16,
        "index_type": "HNSW",
        "index_params": {}
      },
      "search_params": [
        {
          "parallel": 1,
          "top": 10,
          "config": {}
        }
      ]
    },
    "runtime_defaults": {
      "experiment_name": "eigen",
      "connection_params": {},
      "upload_parallel": 16,
      "search_parallel": 1,
      "top_k": 10
    },
    "runtime_bindings": {
      "experiment_name": [{"pointer": "/name"}],
      "connection_params": [{"pointer": "/connection_params", "mode": "merge"}],
      "upload_parallel": [{"pointer": "/upload_params/parallel"}],
      "search_parallel": [{"pointer": "/search_params/0/parallel"}],
      "top_k": [{"pointer": "/search_params/0/top"}]
    },
    "metric_pointers": {
      "qps": "/results/rps",
      "recall": "/results/mean_precisions",
      "mean_latency": "/results/mean_time",
      "p95_latency": "/results/p95_time"
    }
  },
  "search_space": {
    "domain": "common-hnsw-v1",
    "parameters": {
      "hnsw.m": {
        "kind": "integer",
        "default": 16,
        "bounds": [4, 64],
        "step": 1,
        "effect": "index",
        "bindings": [{"pointer": "/upload_params/index_params/M"}],
        "description": "Maximum HNSW graph connections per node."
      },
      "hnsw.ef_construction": {
        "kind": "integer",
        "default": 128,
        "bounds": [8, 512],
        "step": 1,
        "effect": "index",
        "bindings": [{"pointer": "/upload_params/index_params/efConstruction"}],
        "description": "Candidate-list width used while building the HNSW graph."
      },
      "hnsw.ef_search": {
        "kind": "integer",
        "default": 128,
        "bounds": [16, 1024],
        "step": 1,
        "effect": "search",
        "bindings": [{"pointer": "/search_params/0/config/ef"}],
        "description": "Candidate-list width used for each HNSW query."
      }
    },
    "constraints": [
      {
        "id": "ef-search-at-least-top-k",
        "left": {"source": "candidate", "key": "hnsw.ef_search"},
        "op": "ge",
        "right": {"source": "runtime", "key": "top_k"},
        "message": "hnsw.ef_search must be at least top_k"
      }
    ]
  },
  "lifecycle": {
    "reset": "adapter",
    "readiness": "adapter",
    "rebuild_effects": ["collection", "index"],
    "restart_effects": ["server"],
    "reusable_effects": ["search"],
    "supports_search_batching": true
  }
}
