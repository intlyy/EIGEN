{
  "schema_version": 1,
  "id": "pgvector-ann-dense",
  "display_name": "pgvector dense ANN indexes",
  "adapter": {
    "plugin": "vector-db-benchmark",
    "engine": "pgvector",
    "api_version": "1",
    "options": {}
  },
  "capabilities": {
    "vector_kinds": ["dense"],
    "distances": ["l2", "cosine"],
    "filters": [],
    "indexes": ["hnsw", "ivfflat"],
    "notes": [
      "Contains every pgvector ANN index family while intentionally excluding the no-index exact-scan baseline, which is prohibitively expensive inside a full tiny5M tuning budget.",
      "Use pgvector-native-dense when an exact-scan baseline must participate as its own search region.",
      "The vector-db-benchmark runner installs the pgvector multi-index adapter only in each isolated evaluation workspace and does not modify the source checkout."
    ]
  },
  "experiment": {
    "template": {
      "name": "eigen",
      "engine": "pgvector",
      "connection_params": {},
      "collection_params": {},
      "server_params": {
        "postgresql": {
          "shared_buffers_mb": 12288,
          "effective_cache_size_mb": 30720,
          "maintenance_work_mem_mb": 20480,
          "max_wal_size_mb": 8192,
          "work_mem_mb": 64,
          "effective_io_concurrency": 200,
          "random_page_cost": 1.1,
          "max_worker_processes": 32,
          "max_parallel_workers": 16,
          "max_parallel_maintenance_workers": 15
        }
      },
      "upload_params": {
        "parallel": 16,
        "batch_size": 8192,
        "index_type": "hnsw",
        "hnsw_config": {},
        "ivfflat_config": {}
      },
      "search_params": [
        {
          "parallel": 8,
          "top": 10,
          "config": {"index_type": "hnsw"}
        }
      ]
    },
    "runtime_defaults": {
      "experiment_name": "eigen",
      "connection_params": {},
      "upload_parallel": 16,
      "batch_size": 8192,
      "search_parallel": 8,
      "top_k": 10
    },
    "runtime_bindings": {
      "experiment_name": [{"pointer": "/name"}],
      "connection_params": [{"pointer": "/connection_params", "mode": "merge"}],
      "upload_parallel": [{"pointer": "/upload_params/parallel"}],
      "batch_size": [{"pointer": "/upload_params/batch_size"}],
      "search_parallel": [{"pointer": "/search_params/0/parallel"}],
      "top_k": [{"pointer": "/search_params/0/top"}]
    },
    "metric_pointers": {
      "qps": "/results/rps",
      "recall": "/results/mean_precisions",
      "mean_latency": "/results/mean_time",
      "p95_latency": "/results/p95_time"
    }
  },
  "search_space": {
    "domain": "pgvector-ann-dense-v1",
    "partition_by": ["index.type"],
    "parameters": {
      "index.type": {
        "kind": "categorical",
        "default": "hnsw",
        "choices": ["hnsw", "ivfflat"],
        "effect": "index",
        "bindings": [
          {"pointer": "/upload_params/index_type"},
          {"pointer": "/search_params/0/config/index_type"}
        ],
        "description": "Approximate index family; this selector partitions the search into HNSW and IVFFlat regions."
      },
      "hnsw.m": {
        "kind": "integer",
        "default": 16,
        "bounds": [8, 32],
        "step": 1,
        "effect": "index",
        "active_if": [
          {"parameter": "index.type", "op": "eq", "value": "hnsw"}
        ],
        "bindings": [{"pointer": "/upload_params/hnsw_config/m"}],
        "description": "Maximum number of bidirectional HNSW links per node."
      },
      "hnsw.ef_construction": {
        "kind": "integer",
        "default": 128,
        "bounds": [64, 256],
        "step": 1,
        "effect": "index",
        "active_if": [
          {"parameter": "index.type", "op": "eq", "value": "hnsw"}
        ],
        "bindings": [
          {"pointer": "/upload_params/hnsw_config/ef_construct"}
        ],
        "description": "Candidate-list width used to build the HNSW graph."
      },
      "hnsw.ef_search": {
        "kind": "integer",
        "default": 128,
        "bounds": [32, 512],
        "step": 1,
        "log": true,
        "effect": "search",
        "active_if": [
          {"parameter": "index.type", "op": "eq", "value": "hnsw"}
        ],
        "bindings": [{"pointer": "/search_params/0/config/hnsw_ef"}],
        "description": "Candidate-list width used for each HNSW query."
      },
      "ivfflat.lists": {
        "kind": "integer",
        "default": 2048,
        "bounds": [1024, 8192],
        "step": 1,
        "log": true,
        "effect": "index",
        "active_if": [
          {"parameter": "index.type", "op": "eq", "value": "ivfflat"}
        ],
        "bindings": [
          {"pointer": "/upload_params/ivfflat_config/lists"}
        ],
        "description": "Number of IVFFlat coarse clusters. The 2048 default is near sqrt(5M), a useful tiny5M starting point."
      },
      "ivfflat.probes": {
        "kind": "integer",
        "default": 64,
        "bounds": [8, 256],
        "step": 1,
        "log": true,
        "effect": "search",
        "active_if": [
          {"parameter": "index.type", "op": "eq", "value": "ivfflat"}
        ],
        "bindings": [
          {"pointer": "/search_params/0/config/ivfflat_probes"}
        ],
        "description": "Number of IVFFlat coarse clusters searched per query."
      },
      "postgres.shared_buffers_mb": {
        "kind": "integer",
        "default": 12288,
        "bounds": [8192, 14336],
        "step": 1024,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/shared_buffers_mb"}
        ],
        "description": "PostgreSQL shared buffer pool in MiB; bounded for the 40 GiB container."
      },
      "postgres.effective_cache_size_mb": {
        "kind": "integer",
        "default": 30720,
        "bounds": [24576, 34816],
        "step": 2048,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/effective_cache_size_mb"}
        ],
        "description": "Planner estimate of memory available for filesystem and PostgreSQL caching in MiB."
      },
      "postgres.maintenance_work_mem_mb": {
        "kind": "integer",
        "default": 20480,
        "bounds": [8192, 20480],
        "step": 1024,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/maintenance_work_mem_mb"}
        ],
        "description": "Memory budget in MiB for HNSW/IVFFlat index construction."
      },
      "postgres.max_wal_size_mb": {
        "kind": "integer",
        "default": 8192,
        "bounds": [4096, 12288],
        "step": 1024,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/max_wal_size_mb"}
        ],
        "description": "Maximum WAL size in MiB before checkpoint pressure increases."
      },
      "postgres.work_mem_mb": {
        "kind": "integer",
        "default": 64,
        "bounds": [16, 128],
        "step": 16,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/work_mem_mb"}
        ],
        "description": "Per-operation query workspace in MiB, conservatively bounded for eight concurrent searches."
      },
      "postgres.effective_io_concurrency": {
        "kind": "integer",
        "default": 200,
        "bounds": [32, 256],
        "step": 1,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/effective_io_concurrency"}
        ],
        "description": "Planner/executor I/O concurrency hint for SSD-backed benchmark storage."
      },
      "postgres.random_page_cost": {
        "kind": "float",
        "default": 1.1,
        "bounds": [1.0, 2.0],
        "step": 0.1,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/random_page_cost"}
        ],
        "description": "Planner cost of non-sequential reads, restricted to an SSD-oriented range."
      },
      "postgres.max_parallel_workers": {
        "kind": "integer",
        "default": 16,
        "bounds": [8, 16],
        "step": 1,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/max_parallel_workers"}
        ],
        "description": "Cluster-wide parallel worker budget; capped at 16 for the benchmark host."
      },
      "postgres.max_parallel_maintenance_workers": {
        "kind": "integer",
        "default": 15,
        "bounds": [4, 15],
        "step": 1,
        "effect": "server",
        "bindings": [
          {"pointer": "/server_params/postgresql/max_parallel_maintenance_workers"}
        ],
        "description": "Parallel workers available to pgvector index construction, capped at 15."
      }
    },
    "constraints": [
      {
        "id": "hnsw-ef-search-at-least-top-k",
        "left": {"source": "candidate", "key": "hnsw.ef_search"},
        "op": "ge",
        "right": {"source": "runtime", "key": "top_k"},
        "when": [
          {"parameter": "index.type", "op": "eq", "value": "hnsw"}
        ],
        "message": "hnsw.ef_search must be at least top_k"
      },
      {
        "id": "ivfflat-probes-not-greater-than-lists",
        "left": {"source": "candidate", "key": "ivfflat.probes"},
        "op": "le",
        "right": {"source": "candidate", "key": "ivfflat.lists"},
        "when": [
          {"parameter": "index.type", "op": "eq", "value": "ivfflat"}
        ],
        "message": "ivfflat.probes must not exceed ivfflat.lists"
      },
      {
        "id": "parallel-maintenance-workers-within-total",
        "left": {
          "source": "candidate",
          "key": "postgres.max_parallel_maintenance_workers"
        },
        "op": "le",
        "right": {
          "source": "candidate",
          "key": "postgres.max_parallel_workers"
        },
        "message": "max_parallel_maintenance_workers must not exceed max_parallel_workers"
      }
    ]
  },
  "lifecycle": {
    "reset": "adapter",
    "readiness": "adapter",
    "rebuild_effects": ["collection", "index"],
    "restart_effects": ["server"],
    "reusable_effects": ["search"],
    "supports_search_batching": true
  }
}
